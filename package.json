{
  "name": "chronos-monorepo",
  "description": "Deterministic Simulation Testing (DST) framework for Node.js & TypeScript",
  "private": true,
  "type": "module",
  "homepage": "https://docs-site-chronos.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sx4im/chronos.git"
  },
  "bugs": {
    "url": "https://github.com/sx4im/chronos/issues"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc && pnpm --filter @sx4im/chronos-inspector typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "nanoid@^3": "^3.3.18",
      "postcss@>=8 <9": "^8.5.23",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.9"
    }
  },
  "keywords": [
    "deterministic-simulation-testing",
    "dst",
    "distributed-systems",
    "vitest",
    "testing-framework",
    "chaos-engineering",
    "fault-injection",
    "reproducibility",
    "race-conditions",
    "heisenbug",
    "discrete-event-simulation",
    "foundationdb",
    "tigerbeetle",
    "jepsen",
    "time-travel-debugging",
    "virtual-clock",
    "prng",
    "crdt",
    "raft",
    "typescript",
    "nodejs"
  ]
}
